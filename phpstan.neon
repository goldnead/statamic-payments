includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5

    paths:
        - src

    # Corrects a wrong annotation in Statamic itself, see the stub for why.
    stubFiles:
        - phpstan/AddonServiceProvider.stub

    # The analytics addon is a `suggest`, not a `require`: the metrics under
    # src/Integrations/Insights implement its contract and it is not in vendor.
    # Scanned from the test stand-in — the same declarations, byte for byte —
    # so the metrics are checked against the real signatures instead of being
    # reported as forty-one unknown classes. Scanned, not analysed: the file
    # itself is not code this package ships.
    scanFiles:
        - tests/Fakes/insights-contracts.php

    # A ratchet for new code. The baseline is empty because the findings from the
    # first run were fixed; keep it that way rather than appending to it.

    # The view-string exception below matches only when Larastan is 3.12 or
    # newer. CI resolves fresh and gets it; a checkout with 3.11 in its lockfile
    # does not, and would then fail on the *unused* exception instead. Same
    # setting, same reason, as in statamic-marketing.
    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # Larastan (since 3.12) verifies a `view-string` by asking the view
        # finder whether the template exists. This addon registers its
        # `payments::` namespace at boot via loadViewsFrom(), which the
        # analysis never runs, so every namespaced view name is "string, not
        # view-string" — a finding about the analysis environment, not about
        # the view. Same exception as in statamic-marketing,
        # statamic-automations and statamic-lead-magnets.
        #
        # This is why the check was red in CI and green locally: CI resolves
        # Larastan fresh and gets 3.12, the lockfile here still had 3.11. The
        # run of 2026-09-15 was already red for this reason, a week before
        # anyone looked.
        -
            identifier: argument.type
            message: '#expects view-string(\|null)?, string given#'
