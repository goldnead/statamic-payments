# Without this, every site that installs the addon downloads its tests and CI
# config along with the code it actually runs.

/.github            export-ignore
/tests              export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.editorconfig      export-ignore
/phpunit.xml        export-ignore
/pint.json          export-ignore
/phpstan.neon       export-ignore
/phpstan-baseline.neon export-ignore
/addon-lint.json    export-ignore

# Keep: /config, /database, /lang, /routes, /src, README.md, CHANGELOG.md,
# LICENSE.md. This addon ships no built assets — there is no CP screen.
