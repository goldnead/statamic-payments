includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5

    paths:
        - src

    # Corrects a wrong annotation in Statamic itself, see the stub for why.
    stubFiles:
        - phpstan/AddonServiceProvider.stub

    # The analytics addon is a `suggest`, not a `require`: the metrics under
    # src/Integrations/Insights implement its contract and it is not in vendor.
    # Scanned from the test stand-in — the same declarations, byte for byte —
    # so the metrics are checked against the real signatures instead of being
    # reported as forty-one unknown classes. Scanned, not analysed: the file
    # itself is not code this package ships.
    scanFiles:
        - tests/Fakes/insights-contracts.php

    # A ratchet for new code. The baseline is empty because the findings from the
    # first run were fixed; keep it that way rather than appending to it.
